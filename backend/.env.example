# SpecSense Environment Configuration

# 1. Google Gemini API Keys (comma-separated for automatic pool rotation)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq API Keys (comma-separated for fast backup models)
# Get free key from: https://console.groq.com/
GROQ_API_KEY=

# 3. SerpAPI Key (Optional - free live web search fallback)
# Get key from: https://serpapi.com/
SERPAPI_KEY=

# 4. Local Ollama Endpoint (Optional)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# Note: Even without any API keys, SpecSense runs 100% locally via its built-in Zero-API Spec Engine!
